# ---------------------------------------------------------------------------
# Environment variable template — SAFE TO COMMIT (contains no real secrets).
#
# Copy this file to `.env` and fill in real values. `.env` (and `.env.local`,
# `.env.*.local`) is gitignored, so your real keys never get committed.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS/Linux:         cp .env.example .env
#
# NOTE: This project needs NO secrets to build, test, or run. These variables
# are ONLY for the optional Deque `axe` MCP server (see .mcp.json / CLAUDE.md).
# Everything else — the app, unit tests, and the @axe-core/playwright E2E gate —
# works with no keys at all.
# ---------------------------------------------------------------------------

# Deque axe MCP server credential. Provide EXACTLY ONE of the two below.
# The server fails to start if both are set. Get a key from your Deque
# account portal: https://docs.deque.com/devtools-server/4.0.0/en/axe-mcp-server/

# Option A — API key (simplest):
AXE_API_KEY=

# Option B — OAuth 2.0 access token (via @deque/axe-auth); leave AXE_API_KEY blank if you use this:
# AXE_ACCESS_TOKEN=

# Optional: only for regional / on-premises Deque instances.
# AXE_SERVER_URL=
